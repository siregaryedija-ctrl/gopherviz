{
  "name": "gopherviz",
  "displayName": "GopherViz",
  "description": "Visual pixel-art dan animasi cara kerja kode, realtime saat kamu mengetik. Go: nilai asli (loop, if, switch, fungsi, struct, pointer, map, goroutine, channel). JavaScript, TypeScript, Python, PHP, C++, C, Java: alur struktur.",
  "version": "0.14.0",
  "publisher": "gopherviz",
  "private": true,
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Visualization"
  ],
  "keywords": [
    "go",
    "golang",
    "javascript",
    "typescript",
    "python",
    "php",
    "c++",
    "c",
    "java",
    "loop",
    "belajar",
    "visualisasi"
  ],
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:php",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gopherviz.showPanel",
        "title": "Tampilkan panel",
        "category": "GopherViz"
      },
      {
        "command": "gopherviz.visualizeAtCursor",
        "title": "Visualisasikan blok di kursor",
        "category": "GopherViz"
      },
      {
        "command": "gopherviz.restartServer",
        "title": "Mulai ulang server gopherviz",
        "category": "GopherViz"
      },
      {
        "command": "gopherviz.moveTo",
        "title": "Pindahkan panel…",
        "category": "GopherViz",
        "icon": "$(layout)"
      }
    ],
    "keybindings": [
      {
        "command": "gopherviz.visualizeAtCursor",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorLangId =~ /^(go|javascript|javascriptreact|typescript|typescriptreact|python|php|cpp|c|java)$/"
      }
    ],
    "colors": [
      {
        "id": "gopherviz.stepLineBackground",
        "description": "Latar baris yang sedang dijalankan Gopher di editor.",
        "defaults": {
          "dark": "#264f7880",
          "light": "#add6ff80",
          "highContrast": "#264f7880"
        }
      },
      {
        "id": "gopherviz.stepLineBorder",
        "description": "Garis kiri baris yang sedang dijalankan Gopher di editor.",
        "defaults": {
          "dark": "#4fc1ff",
          "light": "#0078d4",
          "highContrast": "#4fc1ff"
        }
      }
    ],
    "configuration": {
      "title": "GopherViz",
      "properties": {
        "gopherviz.realtime": {
          "type": "boolean",
          "default": true,
          "description": "Perbarui visual di setiap ketikan, tanpa menunggu file disimpan."
        },
        "gopherviz.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Buka panel otomatis saat kursor pertama kali masuk ke sebuah blok (loop, if, switch)."
        },
        "gopherviz.location": {
          "type": "string",
          "enum": [
            "editor",
            "sidebar",
            "panel"
          ],
          "default": "editor",
          "enumDescriptions": [
            "Tab editor (bisa diseret ke samping atau bawah editor).",
            "Sidebar kiri, di bawah Explorer.",
            "Panel bawah, sebelah Terminal (tombol dan output di samping gambar)."
          ],
          "description": "Tempat panel GopherViz. Bisa juga dipilih lewat perintah \"GopherViz: Pindahkan panel…\" atau tombol di judul panel."
        },
        "gopherviz.size": {
          "type": "number",
          "default": 100,
          "minimum": 25,
          "maximum": 100,
          "description": "Ukuran gambar dalam persen dari ruang yang tersedia. Bisa juga diatur dengan menyeret pojok kanan bawah gambar (klik dua kali: kembali penuh)."
        },
        "gopherviz.details": {
          "type": "boolean",
          "default": false,
          "description": "Tampilkan teks penjelasan di panel (kode blok, penjelasan, isi/cabang, variabel, output, daftar blok). Bawaan: panel hanya berisi gambar."
        },
        "gopherviz.highlightLine": {
          "type": "boolean",
          "default": true,
          "description": "Sorot baris yang sedang dijalankan Gopher langsung di editor, mengikuti animasi di panel."
        },
        "gopherviz.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Tampilkan tombol \"▶ Visualisasikan\" di atas setiap blok (fungsi, loop, if, switch)."
        },
        "gopherviz.speed": {
          "type": "number",
          "default": 1,
          "enum": [
            0.5,
            1,
            2,
            4
          ],
          "description": "Kecepatan animasi."
        },
        "gopherviz.sound": {
          "type": "boolean",
          "default": true,
          "description": "Efek suara 8-bit."
        },
        "gopherviz.music": {
          "type": "boolean",
          "default": true,
          "description": "Musik latar chiptune."
        },
        "gopherviz.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path ke binary gopherviz. Kosongkan untuk memakai binary bawaan ekstensi."
        },
        "gopherviz.ffmpegPath": {
          "type": "string",
          "default": "",
          "description": "Lokasi ffmpeg (mis. C:\\ffmpeg\\bin\\ffmpeg.exe) untuk menyimpan rekaman animasi sebagai MP4. Kosongkan bila ffmpeg sudah ada di PATH."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "gopherviz-bottom",
          "title": "GopherViz",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "gopherviz.sideView",
          "name": "GopherViz",
          "icon": "media/activity.svg",
          "when": "config.gopherviz.location == 'sidebar'"
        }
      ],
      "gopherviz-bottom": [
        {
          "type": "webview",
          "id": "gopherviz.bottomView",
          "name": "GopherViz",
          "icon": "media/activity.svg",
          "when": "config.gopherviz.location == 'panel'"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "gopherviz.moveTo",
          "when": "activeWebviewPanelId == 'gopherviz.panel'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "gopherviz.moveTo",
          "when": "view == gopherviz.sideView || view == gopherviz.bottomView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "build:bin": "node scripts/build-bin.mjs",
    "build:bin:all": "node scripts/build-bin.mjs --all",
    "test": "npm run build:bin && node scripts/build.mjs --test && node --test out/test/*.test.js",
    "test:vscode": "npm run build:bin && npm run compile && node scripts/test-vscode.mjs",
    "package": "npm run build:bin:all && npm run compile && vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
