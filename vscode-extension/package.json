{
  "name": "gopherviz",
  "displayName": "GopherViz",
  "description": "Visual pixel-art dan animasi cara kerja kode, realtime saat kamu mengetik. Go: nilai asli (loop, if, switch, fungsi, struct, pointer, map, goroutine, channel). JavaScript, TypeScript, Python, PHP, C++, C, Java: alur struktur.",
  "version": "0.6.0",
  "publisher": "gopherviz",
  "private": true,
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Visualization"
  ],
  "keywords": [
    "go",
    "golang",
    "javascript",
    "typescript",
    "python",
    "php",
    "c++",
    "c",
    "java",
    "loop",
    "belajar",
    "visualisasi"
  ],
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:php",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gopherviz.showPanel",
        "title": "Tampilkan panel",
        "category": "GopherViz"
      },
      {
        "command": "gopherviz.visualizeAtCursor",
        "title": "Visualisasikan loop di kursor",
        "category": "GopherViz"
      },
      {
        "command": "gopherviz.restartServer",
        "title": "Mulai ulang server gopherviz",
        "category": "GopherViz"
      }
    ],
    "keybindings": [
      {
        "command": "gopherviz.visualizeAtCursor",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorLangId == go"
      }
    ],
    "configuration": {
      "title": "GopherViz",
      "properties": {
        "gopherviz.realtime": {
          "type": "boolean",
          "default": true,
          "description": "Perbarui visual di setiap ketikan, tanpa menunggu file disimpan."
        },
        "gopherviz.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Buka panel otomatis saat kursor pertama kali masuk ke sebuah loop."
        },
        "gopherviz.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Tampilkan tombol \"Visualisasikan loop\" di atas setiap for."
        },
        "gopherviz.speed": {
          "type": "number",
          "default": 1,
          "enum": [
            0.5,
            1,
            2,
            4
          ],
          "description": "Kecepatan animasi."
        },
        "gopherviz.sound": {
          "type": "boolean",
          "default": true,
          "description": "Efek suara 8-bit."
        },
        "gopherviz.music": {
          "type": "boolean",
          "default": true,
          "description": "Musik latar chiptune."
        },
        "gopherviz.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path ke binary gopherviz. Kosongkan untuk memakai binary bawaan ekstensi."
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "build:bin": "node scripts/build-bin.mjs",
    "build:bin:all": "node scripts/build-bin.mjs --all",
    "test": "npm run build:bin && node scripts/build.mjs --test && node --test out/test/*.test.js",
    "test:vscode": "npm run build:bin && npm run compile && node scripts/test-vscode.mjs",
    "package": "npm run build:bin:all && npm run compile && vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
